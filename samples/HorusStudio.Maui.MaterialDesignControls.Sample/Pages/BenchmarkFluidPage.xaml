<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HorusStudio.Maui.MaterialDesignControls.Sample.Pages"
    xmlns:material="clr-namespace:HorusStudio.Maui.MaterialDesignControls;assembly=HorusStudio.Maui.MaterialDesignControls"
    xmlns:vm="clr-namespace:HorusStudio.Maui.MaterialDesignControls.Sample.ViewModels"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
    x:Class="HorusStudio.Maui.MaterialDesignControls.Sample.Pages.BenchmarkFluidPage"
    x:TypeArguments="vm:BenchmarkFluidViewModel"
    x:DataType="vm:BenchmarkFluidViewModel"
    BackgroundColor="Black">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top app bar -->
        <material:MaterialTopAppBar
            Grid.Row="0"
            Headline="{Binding Title}"
            LeadingIconCommand="{Binding GoBackCommand}"
            LeadingIconIsBusy="{Binding Path=GoBackCommand.IsRunning}"
            LeadingIcon="ic_back.png"
            Type="Small"
            BackgroundColor="Black"
            HeadlineColor="White" />

        <!-- Stats + controls panel -->
        <Grid
            Grid.Row="1"
            BackgroundColor="#1A1A1A"
            Padding="12,8"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="6">

            <!-- Stats row -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                <Label Grid.Column="0" Text="{Binding FpsText}"    TextColor="#4CAF50" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding P95Text}"    TextColor="#FF9800" FontSize="12" HorizontalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding UpdateText}" TextColor="#90CAF9" FontSize="12" HorizontalOptions="Center" />
                <Label Grid.Column="3" Text="{Binding DrawText}"   TextColor="#CE93D8" FontSize="12" HorizontalOptions="Center" />
                <Label Grid.Column="4" Text="{Binding ResText}"    TextColor="#B0BEC5" FontSize="11" HorizontalOptions="Center" />
            </Grid>

            <!-- Controls row -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                <Button
                    Grid.Column="0"
                    Text="{Binding ToggleButtonText}"
                    Clicked="OnToggleClicked"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontSize="13"
                    Padding="12,6"
                    CornerRadius="6" />

                <Button
                    Grid.Column="1"
                    Text="{Binding BackendButtonText}"
                    Clicked="OnBackendClicked"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    FontSize="13"
                    Padding="12,6"
                    CornerRadius="6" />

                <Button
                    Grid.Column="2"
                    Text="Bench 30s"
                    Clicked="OnBenchClicked"
                    BackgroundColor="#7B1FA2"
                    TextColor="White"
                    FontSize="13"
                    Padding="12,6"
                    CornerRadius="6" />
            </Grid>

            <!-- Effect sliders, like the reference editor -->
            <Grid Grid.Row="2" ColumnDefinitions="52,*,52,*" ColumnSpacing="8">
                <Label Grid.Column="0" Text="swirl" TextColor="#888" FontSize="11" VerticalOptions="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Swirl}" MinimumTrackColor="#1565C0" MaximumTrackColor="#444" />
                <Label Grid.Column="2" Text="fade" TextColor="#888" FontSize="11" VerticalOptions="Center" />
                <Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding Fade}" MinimumTrackColor="#1565C0" MaximumTrackColor="#444" />
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="52,*,52,*" ColumnSpacing="8">
                <Label Grid.Column="0" Text="splats" TextColor="#888" FontSize="11" VerticalOptions="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SplatRate}" MinimumTrackColor="#1565C0" MaximumTrackColor="#444" />
                <Label Grid.Column="2" Text="glow" TextColor="#888" FontSize="11" VerticalOptions="Center" />
                <Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding Glow}" MinimumTrackColor="#1565C0" MaximumTrackColor="#444" />
            </Grid>

            <!-- Benchmark status -->
            <Label Grid.Row="4" Text="{Binding BenchText}" TextColor="#FFD54F" FontSize="11" HorizontalOptions="Center" />
        </Grid>

        <!-- Canvas: CPU raster view and GPU view share the slot; the code-behind
             shows exactly one of them depending on the selected backend. -->
        <skia:SKCanvasView
            Grid.Row="2"
            x:Name="CanvasView"
            PaintSurface="OnPaintSurface"
            EnableTouchEvents="False"
            IsVisible="False" />

        <skia:SKGLView
            Grid.Row="2"
            x:Name="GlView"
            PaintSurface="OnPaintGlSurface"
            EnableTouchEvents="False"
            IsVisible="False" />

    </Grid>
</local:BaseContentPage>
