<?xml version="1.0" encoding="utf-8" ?>
<local:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HorusStudio.Maui.MaterialDesignControls.Sample.Pages"
    xmlns:material="clr-namespace:HorusStudio.Maui.MaterialDesignControls;assembly=HorusStudio.Maui.MaterialDesignControls"
    xmlns:vm="clr-namespace:HorusStudio.Maui.MaterialDesignControls.Sample.ViewModels"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
    x:Class="HorusStudio.Maui.MaterialDesignControls.Sample.Pages.BenchmarkWavesPage"
    x:TypeArguments="vm:BenchmarkWavesViewModel"
    x:DataType="vm:BenchmarkWavesViewModel"
    BackgroundColor="Black">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top app bar -->
        <material:MaterialTopAppBar
            Grid.Row="0"
            Headline="{Binding Title}"
            LeadingIconCommand="{Binding GoBackCommand}"
            LeadingIconIsBusy="{Binding Path=GoBackCommand.IsRunning}"
            LeadingIcon="ic_back.png"
            Type="Small"
            BackgroundColor="Black"
            HeadlineColor="White" />

        <!-- Stats + controls panel -->
        <Grid
            Grid.Row="1"
            BackgroundColor="#1A1A1A"
            Padding="12,8"
            RowDefinitions="Auto,Auto"
            RowSpacing="6">

            <!-- Stats row -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                <Label Grid.Column="0" Text="{Binding FpsText}"    TextColor="#4CAF50" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding AvgFpsText}" TextColor="#8BC34A" FontSize="13" HorizontalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding MinFpsText}" TextColor="#FF9800" FontSize="13" HorizontalOptions="Center" />
                <Label Grid.Column="3" Text="{Binding DrawText}"   TextColor="#CE93D8" FontSize="11" HorizontalOptions="Center" />
                <Label Grid.Column="4" Text="{Binding ResText}"    TextColor="#90CAF9" FontSize="11" HorizontalOptions="Center" />
            </Grid>

            <!-- Controls row -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">

                <!-- Start / Stop -->
                <Button
                    Grid.Column="0"
                    Text="{Binding ToggleButtonText}"
                    Clicked="OnToggleClicked"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontSize="13"
                    Padding="12,6"
                    CornerRadius="6" />

                <!-- GPU / CPU backend toggle -->
                <Button
                    Grid.Column="1"
                    Text="{Binding BackendButtonText}"
                    Clicked="OnBackendClicked"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    FontSize="13"
                    Padding="12,6"
                    CornerRadius="6" />

                <!-- Spacer -->
                <BoxView Grid.Column="2" Color="Transparent" />

                <!-- Render scale buttons: CPU backend only (the GPU path always
                     draws at full resolution), hence IsEnabled on the backend. -->
                <Button Grid.Column="3" Text="¼"  Clicked="OnScaleQuarter" IsEnabled="{Binding ScaleButtonsEnabled}" BackgroundColor="#333" TextColor="White" FontSize="12" Padding="10,6" CornerRadius="6" />
                <Button Grid.Column="4" Text="⅓"  Clicked="OnScaleThird"   IsEnabled="{Binding ScaleButtonsEnabled}" BackgroundColor="#333" TextColor="White" FontSize="12" Padding="10,6" CornerRadius="6" />
                <Button Grid.Column="5" Text="½"  Clicked="OnScaleHalf"    IsEnabled="{Binding ScaleButtonsEnabled}" BackgroundColor="#333" TextColor="White" FontSize="12" Padding="10,6" CornerRadius="6" />
                <Button Grid.Column="6" Text="1×" Clicked="OnScaleFull"    IsEnabled="{Binding ScaleButtonsEnabled}" BackgroundColor="#333" TextColor="White" FontSize="12" Padding="10,6" CornerRadius="6" />
            </Grid>
        </Grid>

        <!-- Canvas: CPU raster view and GPU view share the slot; the code-behind
             shows exactly one of them depending on the selected backend. -->
        <skia:SKCanvasView
            Grid.Row="2"
            x:Name="CanvasView"
            PaintSurface="OnPaintSurface"
            EnableTouchEvents="False"
            IsVisible="False" />

        <skia:SKGLView
            Grid.Row="2"
            x:Name="GlView"
            PaintSurface="OnPaintGlSurface"
            EnableTouchEvents="False"
            IsVisible="False" />

    </Grid>
</local:BaseContentPage>
