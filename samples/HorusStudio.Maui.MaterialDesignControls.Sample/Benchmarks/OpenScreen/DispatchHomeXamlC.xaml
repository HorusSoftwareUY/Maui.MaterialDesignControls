                                <Grid ColumnDefinitions="23*,77*" HeightRequest="6">
                                    <BoxView Grid.Column="0" Color="#5B8CFF" CornerRadius="3" />
                                    <BoxView Grid.Column="1" Color="#E3E8F0" CornerRadius="3" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="660 mi left · ETA Thu 4:05 AM" FontSize="11" TextColor="#5B6478" />
                                    <Label Grid.Column="1" Text="23%" FontSize="11" FontAttributes="Bold" TextColor="#0F172A" />
                                </Grid>
                                <material:MaterialDivider Color="#E3E8F0" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="#7A5A2E">
                                        <Label Text="SL" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label Text="Sofia Lindqvist" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="Unit 302 · Volvo VNL" FontSize="11" TextColor="#5B6478" />
                                    </VerticalStackLayout>
                                    <material:MaterialButton Grid.Column="2" Type="Filled" Text="Track" BackgroundColor="#FFB547" TextColor="#0A0F1C" />
                                </Grid>
                            </VerticalStackLayout>
                        </material:MaterialCard>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ═══ Book a pickup ═══ -->
                <material:MaterialCard Type="Filled" BackgroundColor="#FFFFFF" BorderColor="#DCE2EB" BorderWidth="1" CornerRadius="22" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="0">
                            <material:MaterialLabel Text="Book a pickup" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                            <material:MaterialLabel Text="Instant quote · capacity confirmed in under 2 min" FontSize="12" TextColor="#5B6478" />
                        </VerticalStackLayout>
                        <material:MaterialTextField Type="Outlined" Placeholder="Pickup address" Text="4400 Easton Way, Columbus, OH" />
                        <material:MaterialTextField Type="Outlined" Placeholder="Delivery address" Text="1100 Peachtree St, Atlanta, GA" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <material:MaterialPicker Grid.Column="0" Type="Outlined" Placeholder="Equipment" ItemsSource="{Binding EquipmentTypes}" />
                            <material:MaterialPicker Grid.Column="1" Type="Outlined" Placeholder="Service level" ItemsSource="{Binding ServiceLevels}" />
                        </Grid>
                        <material:MaterialTextField Type="Outlined" Placeholder="Pickup date" Text="Thu, Nov 5 · 8:00 AM – 12:00 PM" />
                        <material:MaterialSlider Label="Estimated weight · 18,000 lb" Value="0.45" />
                        <material:MaterialSwitch Text="Liftgate required at delivery" IsToggled="True" />
                        <material:MaterialSwitch Text="Hazardous materials (placarded)" />
                        <material:MaterialSwitch Text="Temperature controlled" />
                        <material:MaterialDivider Color="#E3E8F0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Estimated rate" FontSize="12" TextColor="#5B6478" />
                                <Label Text="$1,286.40" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="568 mi · $2.26/mi" FontSize="12" TextColor="#5B6478" VerticalOptions="End" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <material:MaterialButton Grid.Column="0" Type="Outlined" Text="Save draft" />
                            <material:MaterialButton Grid.Column="1" Type="Filled" Text="Book now" BackgroundColor="#FFB547" TextColor="#0A0F1C" />
                        </Grid>
                    </VerticalStackLayout>
                </material:MaterialCard>

                <!-- ═══ Recent shipments (bound list) ═══ -->
                <Grid ColumnDefinitions="*,Auto">
                    <material:MaterialLabel Text="Recent shipments" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                    <material:MaterialButton Grid.Column="1" Type="Text" Text="Export CSV" TextColor="#C27C0E" />
                </Grid>
                <material:MaterialCard Type="Filled" BackgroundColor="#FFFFFF" BorderColor="#DCE2EB" BorderWidth="1" CornerRadius="22" Padding="8,4" Margin="0,-10,0,0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Shipments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="os:ShipmentRow">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="8,12">
                                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{Binding AvatarColor}" VerticalOptions="Center">
                                            <Label Text="{Binding Initials}" FontSize="13" FontAttributes="Bold" TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Shipper}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Lane}" FontSize="12" TextColor="#5B6478" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Tracking}" FontSize="11" TextColor="#8A93A6" />
                                                <Label Text="·" FontSize="11" TextColor="#8A93A6" />
                                                <Label Text="{Binding Pallets}" FontSize="11" TextColor="#8A93A6" />
                                                <Label Text="·" FontSize="11" TextColor="#8A93A6" />
                                                <Label Text="{Binding Weight}" FontSize="11" TextColor="#8A93A6" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                            <Border StrokeThickness="1" Stroke="{Binding StatusColor}" StrokeShape="RoundRectangle 9" Padding="8,2" HorizontalOptions="End">
                                                <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                            </Border>
                                            <Label Text="{Binding Eta}" FontSize="11" TextColor="#5B6478" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#E6EAF1" Margin="60,0,8,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </material:MaterialCard>

                <!-- ═══ Driver of the week ═══ -->
                <Border StrokeThickness="1" Stroke="#F5D9A0" StrokeShape="RoundRectangle 22" Padding="16" BackgroundColor="#FFF7E6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="2" Stroke="#FFB547" StrokeShape="Ellipse" BackgroundColor="#7A5A2E">
                            <Label Text="TB" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="DRIVER OF THE WEEK" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="#C27C0E" />
                            <Label Text="Tanya Brooks" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Text="2,940 mi · 14 stops · zero exceptions" FontSize="12" TextColor="#5B6478" />
                            <material:MaterialRating Value="5" ItemsSize="18" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentView>
