        </Grid>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="12" TextColor="#B0BEC5" />
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Email}" FontSize="12" TextColor="#B0BEC5" />
