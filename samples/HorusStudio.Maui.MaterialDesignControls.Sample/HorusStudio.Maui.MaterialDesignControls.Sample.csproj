	  </Reference>
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
		<Reference Include="HorusStudio.Maui.MaterialDesignControls">
			<HintPath>..\..\..\..\..\..\Desktop\Material\v1.0.0\iOS\HorusStudio.Maui.MaterialDesignControls.dll</HintPath>
		</Reference>
	</ItemGroup>
	-->
</Project>
