# Startup profiling environment (opt-in via -p:EnableStartupProfiling=true).
# Captures a startup .nettrace directly on-device (no dsrouter/dotnet-trace,
# avoiding the broken EventPipe-over-dsrouter finalization in dotnet/maui#36637).
# Mirrors the known-good dotnet-optimization IBC configuration used by
# Microsoft.Maui.Cli's MauiProfilingHelperInjection.targets.
MAUI_PROFILING_HELPER=1
DOTNET_EnableEventPipe=1
DOTNET_EventPipeConfig=Microsoft-Windows-DotNETRuntime:0x1F000080018:5
DOTNET_EventPipeOutputPath=/data/data/com.horusstudio.maui.materialdesigncontrols.sample.coreclr/files/startup.nettrace
DOTNET_TieredPGO=1
DOTNET_TieredPGO_InstrumentOnlyHotCode=0
DOTNET_TC_QuickJitForLoops=1
DOTNET_TC_CallCountThreshold=10000
DOTNET_ReadyToRun=0
DOTNET_JitMinimalJitProfiling=1
DOTNET_JitProfileCasts=1
DOTNET_JitDelegateProfiling=0
DOTNET_MULTILEVEL_LOOKUP=0
